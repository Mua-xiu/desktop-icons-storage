<UserControl x:Class="DesktopIconsStorage.App.Views.BlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
             FontSize="12">
    <UserControl.Resources>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" CornerRadius="8"
            BorderThickness="1" BorderBrush="#33FFFFFF" Background="Transparent">
        <Grid x:Name="SurfaceRoot">
            <!-- 自绘毛玻璃底层：壁纸裁剪模糊 + 主题色叠加（圆角由 RootBorder 裁剪，角部干净） -->
            <Image x:Name="FrostImage" Stretch="Fill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="Linear"/>
            <Border x:Name="FrostTint"/>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：拖动移动 / 双击折叠展开 / 右键菜单 -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" ToolTip="双击折叠 / 展开">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBox x:Name="TitleEditor" Visibility="Collapsed" Width="150"
                             VerticalAlignment="Center" Padding="2,1" FontSize="12"/>
                </StackPanel>

                <Border x:Name="CountBadge" Grid.Column="1" CornerRadius="8" Padding="7,1"
                        Margin="4,0,10,0" VerticalAlignment="Center" Background="#33000000">
                    <TextBlock x:Name="CountText" FontSize="11" Foreground="#CCFFFFFF"/>
                </Border>
            </Grid>

            <!-- 图标网格：滚动条隐藏，滚轮照常滚动（无滚动条即无闪烁与样式问题） -->
            <ListBox x:Name="IconList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Padding="6,2,6,6" SelectionMode="Extended" AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     FocusVisualStyle="{x:Null}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="74" ItemHeight="100"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{Binding CellWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="0,3"
                                    ToolTip="{Binding Name}"
                                    ToolTipService.Placement="Mouse"
                                    ToolTipService.InitialShowDelay="250">
                            <Border CornerRadius="8" Padding="6" HorizontalAlignment="Center"
                                    Background="{Binding TileBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    BorderBrush="{Binding TileBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    BorderThickness="1">
                                <Image Source="{Binding Icon}"
                                       Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock x:Name="ItemName" Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="18" Margin="0,4,0,0"
                                       Visibility="{Binding NamesVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <!-- 2026-09-24：旧模式名称默认单行，选中后才展开完整文本。 -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="ItemName" Property="TextWrapping" Value="Wrap"/>
                                <Setter TargetName="ItemName" Property="TextTrimming" Value="None"/>
                                <Setter TargetName="ItemName" Property="MaxHeight" Value="1000"/>
                                <Setter TargetName="ItemName" Property="Background" Value="{DynamicResource CardBg}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3300A5FF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 框选层：不拦截命中，仅绘制选框 -->
            <Canvas x:Name="MarqueeLayer" Grid.Row="1" IsHitTestVisible="False">
                <Border x:Name="MarqueeRect" Visibility="Collapsed"
                        Background="#2200A5FF" BorderBrush="#6600A5FF"
                        BorderThickness="1" CornerRadius="2"/>
            </Canvas>

            <!-- 缩放手柄：四边 + 四角（八向自由拉伸） -->
            <Thumb x:Name="RzN" Tag="N" Grid.RowSpan="2" Height="10" VerticalAlignment="Top"
                   Cursor="SizeNS" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            <Thumb x:Name="RzS" Tag="S" Grid.RowSpan="2" Height="10" VerticalAlignment="Bottom"
                   Cursor="SizeNS" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            <Thumb x:Name="RzE" Tag="E" Grid.RowSpan="2" Width="10" HorizontalAlignment="Right"
                   Cursor="SizeWE" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            <Thumb x:Name="RzW" Tag="W" Grid.RowSpan="2" Width="10" HorizontalAlignment="Left"
                   Cursor="SizeWE" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            <Thumb x:Name="RzNE" Tag="NE" Grid.RowSpan="2" Width="20" Height="20"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            <Thumb x:Name="RzNW" Tag="NW" Grid.RowSpan="2" Width="20" Height="20"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            <Thumb x:Name="RzSE" Tag="SE" Grid.RowSpan="2" Width="20" Height="20"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            <Thumb x:Name="RzSW" Tag="SW" Grid.RowSpan="2" Width="20" Height="20"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Opacity="0" DragDelta="OnResizeThumb" DragCompleted="OnResizeCompleted"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
