<UserControl x:Class="DesktopIconsStorage.App.Views.LinkBasketPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13">
    <UserControl.Resources>
        <!-- 页面圆点在一页时隐藏，多页时保持轻量且可点击。 -->
        <Style x:Key="PageDot" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="RootBorder" CornerRadius="16" BorderThickness="1"
            Background="Transparent" BorderBrush="#70FFFFFF">
        <Grid>
            <Border x:Name="TintLayer" CornerRadius="16" Background="#33202020"/>
            <Grid x:Name="ContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <!-- 顶部操作区：名称开关只控制本筐的展开窗口。 -->
                <Grid Grid.Row="0" Margin="18,8,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="18"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,4,0">
                        <TextBlock Text="显示名称" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="NamesToggle" Style="{StaticResource Switch}"
                                  VerticalAlignment="Center" Cursor="Hand"
                                  AutomationProperties.Name="显示名称"/>
                    </StackPanel>
                </Grid>
                <!-- 快捷方式列表：关闭名称时使用随主题变化的完整名称提示。 -->
                <ListBox x:Name="IconList" Grid.Row="1" Margin="10,0,10,12"
                         Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                         AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="92" ItemHeight="104"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="88" Margin="2" HorizontalAlignment="Center"
                                        ToolTipService.IsEnabled="{Binding NamesHidden, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel.ToolTip>
                                    <ToolTip Background="{DynamicResource PopupBg}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderBrush="{DynamicResource BorderSoft}"
                                             Padding="10,6" Content="{Binding Name}"/>
                                </StackPanel.ToolTip>
                                <Border Width="62" Height="62" CornerRadius="10"
                                        Background="#30FFFFFF" HorizontalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="44" Height="44"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="2,5,2,0"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="32"
                                           Visibility="{Binding NamesVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 多页时在窗口底部居中显示可切换的页面圆点。 -->
                <StackPanel x:Name="PageDots" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
