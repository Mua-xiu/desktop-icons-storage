<Window x:Class="DesktopIconsStorage.App.Views.DeleteBlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除收纳块" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF202020" Foreground="White"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <RadioButton x:Name="OptDesktop" Content="把图标移回桌面（推荐）" IsChecked="True"
                     Margin="0,0,0,8" Foreground="White" GroupName="DeleteChoice"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="OptMove" Content="移入其他块：" VerticalAlignment="Center"
                         Foreground="White" GroupName="DeleteChoice"/>
            <ComboBox x:Name="TargetCombo" Width="170" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock Text="两种方式都会删除块对应的文件夹。" Foreground="#FF9E9E9E"
                   FontSize="12" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Margin="0,0,8,0" Padding="0,5" Click="OnCancel"/>
            <Button Content="删除" Width="80" Padding="0,5" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
