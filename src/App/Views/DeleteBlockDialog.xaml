<Window x:Class="DesktopIconsStorage.App.Views.DeleteBlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除收纳盒" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="删除收纳盒" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="PromptText" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- 文件处理选项卡片 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <RadioButton x:Name="OptDesktop" Content="将文件移回桌面（推荐）"
                             IsChecked="True" GroupName="DeleteChoice"/>
                <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,13"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="OptMove" Grid.Column="0"
                                 Content="移入其他收纳盒" GroupName="DeleteChoice"/>
                    <ComboBox x:Name="TargetCombo" Grid.Column="1" MinWidth="180"
                              Margin="16,0,0,0" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="NoOtherBoxText" Visibility="Collapsed"
                           Text="当前没有其他收纳盒，此选项不可用。"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12"
                           Margin="24,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 风险提示 -->
        <Border Grid.Row="2" Background="{DynamicResource ControlBg}"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
            <TextBlock x:Name="RiskText" Text="删除后收纳盒对应的空文件夹也会被移除，文件不会被直接删除。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        </Border>

        <!-- 操作区 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="88" Margin="0,0,10,0" Click="OnCancel"/>
            <Button Content="删除" Width="88" Background="{DynamicResource Accent}"
                    Foreground="White" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
