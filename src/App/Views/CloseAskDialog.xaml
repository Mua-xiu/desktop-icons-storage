<Window x:Class="DesktopOrganizer.App.Views.CloseAskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF202020" Foreground="White"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock Text="要退出桌面收纳吗？" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="桌面收纳需要在后台持续运行才能保持收纳块显示。可以选择隐藏到系统托盘，需要时从托盘菜单退出。"
                   TextWrapping="Wrap" Foreground="#FFB0B0B0" Margin="0,0,0,14"/>
        <CheckBox x:Name="RememberBox" Content="记住我的选择" Margin="0,0,0,16" Foreground="White"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="退出应用" Width="110" Margin="0,0,8,0" Padding="0,6" Click="OnExit"/>
            <Button Content="隐藏到托盘" Width="110" Padding="0,6" Click="OnHide"/>
        </StackPanel>
    </StackPanel>
</Window>
