<UserControl x:Class="DesktopIconsStorage.App.Views.LinkBasketTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:DesktopIconsStorage.App.Helpers"
             FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="12">
    <!-- 小盒预览区：所有图标均为只读图像，整个区域只负责打开内容窗口。 -->
    <helpers:RoundedSurface x:Name="TileBorder"
            Background="Transparent" BorderBrush="#70FFFFFF">
        <Grid x:Name="TileRoot" AllowDrop="True">
            <Border x:Name="TintLayer" Background="#1A202020"/>
            <!-- 图标预览区：名称已移至盒子外部，不再预留底部标题行。 -->
            <UniformGrid x:Name="PreviewGrid" Margin="10,8" IsHitTestVisible="False"/>
            <!-- 重命名操作区：编辑器仅在用户触发重命名时临时显示。 -->
            <TextBox x:Name="TitleEditor" Visibility="Collapsed" VerticalAlignment="Center"
                     Margin="8" HorizontalAlignment="Stretch" FontSize="11"/>
            <Border x:Name="MoreBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,5,5,0" Padding="5,1" CornerRadius="8"
                    Background="#99000000" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="MoreCount" Foreground="White" FontSize="10"/>
            </Border>
        </Grid>
    </helpers:RoundedSurface>
</UserControl>
