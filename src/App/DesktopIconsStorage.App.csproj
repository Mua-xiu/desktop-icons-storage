<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DesktopIconsStorage</AssemblyName>
    <RootNamespace>DesktopIconsStorage.App</RootNamespace>
    <Version>0.3.0</Version>
    <Product>DesktopIconsStorage</Product>
    <Authors>Mua-xiu</Authors>
    <Company>Mua-xiu</Company>
    <Copyright>Copyright © 2026 Mua-xiu</Copyright>
    <RepositoryUrl>https://github.com/Mua-xiu/desktop-icons-storage</RepositoryUrl>
    <Description>纯粹简约的 Windows 桌面图标整理工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-light.ico" />
    <Resource Include="Assets\app-dark.ico" />
    <ProjectReference Include="..\Core\DesktopIconsStorage.Core.csproj" />
    <ProjectReference Include="..\Platform.Windows\DesktopIconsStorage.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
