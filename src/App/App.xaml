<Application x:Class="DesktopIconsStorage.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup" Exit="OnExit"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 基础控件与盒体菜单只维护一份全局样式。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 主题资源由 ThemeResourceManager 在系统或用户主题变化时统一更新。 -->
            <SolidColorBrush x:Key="WindowBg" Color="#FF202020"/>
            <SolidColorBrush x:Key="NavBg" Color="#FF202020"/>
            <SolidColorBrush x:Key="CardBg" Color="#FF2B2B2B"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#FFC5C5C5"/>
            <SolidColorBrush x:Key="NavHeader" Color="#FF9D9D9D"/>
            <SolidColorBrush x:Key="ControlBg" Color="#FF2D2D2D"/>
            <SolidColorBrush x:Key="ControlBgHover" Color="#FF353535"/>
            <SolidColorBrush x:Key="ControlBgPress" Color="#FF282828"/>
            <SolidColorBrush x:Key="BorderSoft" Color="#FF3D3D3D"/>
            <SolidColorBrush x:Key="TrackOff" Color="#FF5A5A5A"/>
            <SolidColorBrush x:Key="PopupBg" Color="#FF2B2B2B"/>
            <SolidColorBrush x:Key="MenuBg" Color="#FF2B2B2E"/>
            <SolidColorBrush x:Key="MenuHover" Color="#FF3F4A5C"/>
            <SolidColorBrush x:Key="MenuBorder" Color="#FF505055"/>
            <SolidColorBrush x:Key="Accent" Color="#FF3D9BFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
